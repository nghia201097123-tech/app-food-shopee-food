{
  "manifest_version": 3,
  "name": "Shopee Food Data Extractor",
  "version": "1.0.0",
  "description": "Extract order data from Shopee Partner",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "https://partner.shopee.vn/*",
    "http://localhost:3000/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://partner.shopee.vn/*"],
      "js": ["content.js"],
      "css": ["content.css"]
    }
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
