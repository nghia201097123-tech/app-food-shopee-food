{
  "manifest_version": 3,
  "name": "Shopee Food Data Extractor",
  "version": "1.1.0",
  "description": "Extract order data from Shopee Partner",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "https://partner.shopee.vn/*",
    "https://app.partner.shopee.vn/*",
    "https://gmerchant.deliverynow.vn/*",
    "http://localhost:3000/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://partner.shopee.vn/*"],
      "js": ["content.js"],
      "css": ["content.css"]
    }
  ]
}
